{
  "name": "easysprite",
  "version": "0.1.0",
  "description": "Local CLI + web tool for composing modular pixel-art character sprites",
  "type": "module",
  "bin": {
    "easysprite": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve --dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup src/cli.ts src/mcp/server.ts --format esm --dts --clean --out-dir dist",
    "build:web": "vite build --config web/vite.config.ts",
    "serve": "tsx src/cli.ts serve",
    "desktop": "tsx src/cli.ts desktop",
    "desktop:shortcut": "tsx src/cli.ts desktop --shortcut-only",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/server.ts --http --port 8790",
    "init": "tsx src/cli.ts init",
    "vendor:fetch": "node scripts/fetch-vendors.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.0",
    "hono": "^4.8.3",
    "open": "^10.1.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.2"
  }
}
